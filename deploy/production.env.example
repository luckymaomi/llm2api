# Copy this file outside the repository and replace every example path/value.
LLM2API_GATEWAY_IMAGE=registry.example.test/llm2api@sha256:replace_with_release_digest
LLM2API_POSTGRES_IMAGE=postgres@sha256:replace_with_postgres_18_4_digest
LLM2API_VALKEY_IMAGE=valkey/valkey@sha256:replace_with_valkey_9_1_0_digest
LLM2API_CADDY_IMAGE=caddy@sha256:replace_with_caddy_2_10_2_digest
LLM2API_ACTIVE_MASTER_KEY_VERSION=1
LLM2API_SITE_ADDRESS=gateway.example.test
LLM2API_ACME_EMAIL=operations@example.test
LLM2API_POSTGRES_DB=llm2api
LLM2API_POSTGRES_USER=llm2api
LLM2API_POSTGRES_PASSWORD_FILE=/etc/llm2api/secrets/postgres-password
LLM2API_DATABASE_URL_FILE=/etc/llm2api/secrets/database-url
LLM2API_VALKEY_PASSWORD_FILE=/etc/llm2api/secrets/valkey-password
LLM2API_VALKEY_ACL_FILE=/etc/llm2api/secrets/valkey-acl
LLM2API_MASTER_KEYS_FILE=/etc/llm2api/secrets/master-keys
LLM2API_SESSION_PEPPER_FILE=/etc/llm2api/secrets/session-pepper
LLM2API_API_KEY_PEPPER_FILE=/etc/llm2api/secrets/api-key-pepper
LLM2API_COORDINATION_KEY_HASH_SECRET_FILE=/etc/llm2api/secrets/coordination-secret
