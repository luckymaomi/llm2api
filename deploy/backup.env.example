# Keep this file and all Restic control files outside /etc/llm2api and the staging root.
LLM2API_BACKUP_MODE=production
LLM2API_RESTIC_IMAGE=restic/restic@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510
LLM2API_RESTIC_REPOSITORY_FILE=/etc/llm2api-backup/repository
LLM2API_RESTIC_PASSWORD_FILE=/etc/llm2api-backup/password
# Production currently supports only an S3 repository and requires this root-only credentials file.
LLM2API_RESTIC_AWS_CREDENTIALS_FILE=/etc/llm2api-backup/aws-credentials
# LLM2API_RESTIC_AWS_CONFIG_FILE=/etc/llm2api-backup/aws-config
# Production repository files must contain one remote S3 Restic URL. Isolated acceptance
# uses LLM2API_BACKUP_MODE=acceptance, repository local:/repository, and an explicit local directory.
# LLM2API_RESTIC_LOCAL_REPOSITORY_DIRECTORY=/var/lib/llm2api-backup-acceptance/repository
LLM2API_DEPLOYMENT_ENVIRONMENT_FILE=/etc/llm2api/deployment.env
LLM2API_CONFIGURATION_DIRECTORY=/etc/llm2api
LLM2API_BACKUP_STAGING_ROOT=/var/lib/llm2api-backup
LLM2API_BACKUP_LAST_SUCCESS_MARKER_FILE=/var/lib/llm2api-backup/last-success
LLM2API_RESTIC_CHECK_SUBSET=5%
