LLM2API_PROFILE=production
LLM2API_HTTP_ADDRESS=127.0.0.1:8080
LLM2API_PUBLIC_ORIGIN=https://gateway.example.test
LLM2API_DATABASE_URL_FILE=C:\ProgramData\LLM2API\secrets\database-url
LLM2API_DATABASE_MIGRATE_ON_START=false
LLM2API_VALKEY_ADDRESS=127.0.0.1:6379
LLM2API_VALKEY_PASSWORD_FILE=C:\ProgramData\LLM2API\secrets\valkey-password
LLM2API_MASTER_KEYS_FILE=C:\ProgramData\LLM2API\secrets\master-keys
LLM2API_ACTIVE_MASTER_KEY_VERSION=1
LLM2API_SESSION_PEPPER_FILE=C:\ProgramData\LLM2API\secrets\session-pepper
LLM2API_API_KEY_PEPPER_FILE=C:\ProgramData\LLM2API\secrets\api-key-pepper
LLM2API_CREDENTIAL_FINGERPRINT_PEPPER_FILE=C:\ProgramData\LLM2API\secrets\credential-fingerprint-pepper
LLM2API_COORDINATION_KEY_HASH_SECRET_FILE=C:\ProgramData\LLM2API\secrets\coordination-secret
LLM2API_COOKIE_SECURE=true
